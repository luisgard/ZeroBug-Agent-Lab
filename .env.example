# Copy to .env.local and fill in. Never commit .env.local. Read only by server-side code.

# Real OpenAI Agents API + Decisions API (optional; without it they are BLOCKED and offline runners are used)
OPENAI_API_KEY=
# "decisions" = use the Decisions API to read the agent's replies (needs OPENAI_API_KEY); "heuristic" = offline rules
ZB_JUDGE=heuristic
# "rules" = always design tests with the offline rules, even with a key (predictable demos)
# ZB_PLANNER=rules
ZB_AGENTS_MODEL=gpt-6-astra

# Localhost agents are allowed automatically on your machine. Uncomment only to block them (0) or force them (1).
# ZB_ALLOW_PRIVATE_AGENT_URLS=0
ZB_DEPLOYMENT=local

# Bridge tool host (agents call this). Set a public TLS URL when the agent runs on another machine.
ZB_BRIDGE_PORT=3000
ZB_BRIDGE_PUBLIC_URL=
ZB_UI_PORT=3001
ZB_MAX_CONCURRENT_RUNS=4

# Credential ZeroBug sends to the agent endpoint (if the agent requires one)
ZB_AGENT_TOKEN=
# Read-only credential for a black-box verifier (e.g. a staging outbox). Never sent to the agent.
ZB_VERIFIER_READ_TOKEN=

# Where run evidence is written
ZB_DATA_DIR=data/runs

# Evidence connectors (see docs/CONNECTORS.md). Source definitions: zerobug.sources.json
ZB_SOURCES_FILE=zerobug.sources.json
ZB_GMAIL_CLIENT_ID=
ZB_GMAIL_CLIENT_SECRET=
ZB_GMAIL_REFRESH_TOKEN=
ZB_STRIPE_RESTRICTED_KEY=
ZB_SHOP_READ_TOKEN=

# Connections screen
ZB_SECRET_KEY=
ZB_PUBLIC_URL=http://127.0.0.1:3001
ZB_GOOGLE_CLIENT_ID=
ZB_GOOGLE_CLIENT_SECRET=
